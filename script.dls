- set name  "name"

- msg "Hello, " + $name

- if $name = "name"
- msg "nice"
- endif

- set edad, 18
- if $edad = 18
- msg "Eres mayor de edad"
- else
- msg "Eres menor de edad"
- endif

- if =OS() = "Linux"
- msg "Estás en Linux"
- else
- msg "Estás en otro SO"
- endif

- set i, 5
- if $i > 0
- if $i < 10
- msg "i está entre 1 y 9"
- endif
- endif

